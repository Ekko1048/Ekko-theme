{
  "sections": {
    "main-product": {
      "type": "main-product-modal",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_size": "text-base"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "title_size": "product-title-md",
            "title_size_mobile": "product-title-md",
            "show_price": true,
            "show_rating": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "show_variant_labels": true,
            "picker_type": "button",
            "enable_color_swatches": true,
            "color_swatch_type": "color",
            "size_chart": ""
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "inventory_style": "status_bar",
            "inventory_threshold": 15,
            "inventory_bar_max": 20,
            "show_inventory_transfer": true,
            "show_inventory_quantity": "always",
            "in_stock_color": "#109B36",
            "low_stock_color": "#109B36",
            "bar_background_color": "#E5E7EB"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_price": false,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true,
            "enable_back_in_stock": true,
            "show_back_in_stock_name": true,
            "show_back_in_stock_phone": true
          }
        },
        "read_more": {
          "type": "read_more",
          "settings": {
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "variant_picker",
        "inventory",
        "buy_buttons",
        "read_more"
      ],
      "settings": {
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_autoplay": true,
        "enable_video_looping": true,
        "mobile_layout": "full_width"
      }
    }
  },
  "order": [
    "main-product"
  ]
}
