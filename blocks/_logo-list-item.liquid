{% doc %}
  Renders one reusable logo item inside the Logo list section.
{% enddoc %}

{%- liquid
  assign logo_alt = block.settings.accessible_label | default: block.settings.image.alt
  assign mobile_logo = block.settings.image_mobile | default: block.settings.image
-%}

<div
  class="ekko-logo-item"
  style="--ekko-logo-scale: {{ block.settings.logo_scale | divided_by: 100.0 }}; --ekko-logo-scale-mobile: {{ block.settings.logo_scale_mobile | divided_by: 100.0 }}; --ekko-logo-active-scale: var(--ekko-logo-scale);"
  {{ block.shopify_attributes }}
>
  {%- capture logo_markup -%}
    {%- if block.settings.image != blank -%}
      <picture>
        {%- if block.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_logo | image_url: width: 240 }} 240w,
              {{ mobile_logo | image_url: width: 400 }} 400w,
              {{ mobile_logo | image_url: width: 600 }} 600w
            "
            width="{{ mobile_logo.width }}"
            height="{{ mobile_logo.height }}"
          >
        {%- endif -%}
        {{ block.settings.image | image_url: width: 800 | image_tag:
          loading: 'lazy',
          widths: '160, 240, 320, 400, 600, 800',
          sizes: '(max-width: 749px) 44vw, 16vw',
          alt: logo_alt,
          class: 'ekko-logo-item__image'
        }}
      </picture>
    {%- else -%}
      {{ 'logo' | placeholder_svg_tag: 'ekko-logo-item__placeholder' }}
    {%- endif -%}
  {%- endcapture -%}

  {%- if block.settings.link != blank -%}
    <a
      class="ekko-logo-item__link"
      href="{{ block.settings.link }}"
      aria-label="{{ logo_alt | default: shop.name | escape }}"
      {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
    >
      {{- logo_markup -}}
    </a>
  {%- else -%}
    <div class="ekko-logo-item__media">{{- logo_markup -}}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ekko-logo-item {
    display: grid;
    width: 100%;
    height: var(--ekko-logo-height);
    min-width: 0;
    place-items: center;
    overflow: hidden;
    border-radius: var(--ekko-logo-radius);
    background: var(--ekko-logo-tile-background);
  }

  .ekko-logo-item__link,
  .ekko-logo-item__media {
    display: grid;
    width: 100%;
    height: 100%;
    padding: clamp(.75rem, 1.5vw, 1.5rem);
    place-items: center;
    color: inherit;
  }

  .ekko-logo-item__link {
    cursor: pointer;
    text-decoration: none;
  }

  .ekko-logo-item picture {
    display: contents;
  }

  .ekko-logo-item__image,
  .ekko-logo-item__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform: translateZ(0) scale(var(--ekko-logo-active-scale));
    transition: filter 220ms ease, opacity 220ms ease, transform 220ms ease;
  }

  .ekko-logo-list[data-logo-mode='grayscale'] .ekko-logo-item__image,
  .ekko-logo-list[data-logo-mode='grayscale'] .ekko-logo-item__placeholder {
    filter: grayscale(1);
  }

  .ekko-logo-list[data-logo-mode='muted'] .ekko-logo-item__image,
  .ekko-logo-list[data-logo-mode='muted'] .ekko-logo-item__placeholder {
    filter: grayscale(1);
    opacity: .56;
  }

  @media (hover: hover) {
    .ekko-logo-list[data-restore-color='true'] .ekko-logo-item__link:hover :is(.ekko-logo-item__image, .ekko-logo-item__placeholder) {
      filter: none;
      opacity: 1;
      transform: translate3d(0, -2px, 0) scale(var(--ekko-logo-active-scale));
    }
  }

  .ekko-logo-item__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  @media screen and (max-width: 749px) {
    .ekko-logo-item {
      height: var(--ekko-logo-height-mobile);
      --ekko-logo-active-scale: var(--ekko-logo-scale-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ekko-logo-item__image,
    .ekko-logo-item__placeholder {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.logo_list.blocks.logo.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.logo_list.blocks.logo.image" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:sections.logo_list.blocks.logo.image_mobile" },
    { "type": "url", "id": "link", "label": "t:sections.logo_list.blocks.logo.link" },
    { "type": "text", "id": "accessible_label", "label": "t:sections.logo_list.blocks.logo.accessible_label", "info": "t:sections.logo_list.blocks.logo.accessible_label_info" },
    { "type": "checkbox", "id": "open_new_tab", "label": "t:sections.logo_list.blocks.logo.open_new_tab", "default": false, "visible_if": "{{ block.settings.link != blank }}" },
    { "type": "range", "id": "logo_scale", "label": "t:sections.logo_list.blocks.logo.logo_scale", "min": 50, "max": 120, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "logo_scale_mobile", "label": "t:sections.logo_list.blocks.logo.logo_scale_mobile", "min": 50, "max": 120, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "t:sections.logo_list.blocks.logo.name" }]
}
{% endschema %}
