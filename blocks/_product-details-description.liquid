{% doc %}
  Renders the current product description inside Product details.
{% enddoc %}

{%- if product.description != blank -%}
  <article class="ekko-product-details__description" style="--ekko-pd-description-size: {{ block.settings.font_size }}px;" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h3 class="ekko-product-details__description-heading">{{ block.settings.heading | escape }}</h3>
    {%- endif -%}
    <div class="ekko-product-details__description-copy rte">{{ product.description }}</div>
  </article>
{%- endif -%}

{% stylesheet %}
  .ekko-product-details__description {
    display: grid;
    gap: .625rem;
    padding: 0 0 clamp(1rem, 1.75vw, 1.75rem);
  }

  .ekko-product-details__description-heading {
    margin: 0;
    font-size: clamp(1.2rem, 1.6vw, 1.6rem);
    line-height: 1.1;
    letter-spacing: -.025em;
  }

  .ekko-product-details__description-copy {
    max-width: 70ch;
    color: color-mix(in srgb, currentColor 76%, transparent);
    font-size: var(--ekko-pd-description-size, 1rem);
    line-height: 1.55;
  }

  .ekko-product-details__description-copy > :first-child { margin-block-start: 0; }
  .ekko-product-details__description-copy > :last-child { margin-block-end: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Product description",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product description" },
    { "type": "range", "id": "font_size", "label": "Text size", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Product description" }]
}
{% endschema %}
