{% doc %}
  Renders a button inside a Slideshow 2 slide.
{% enddoc %}

{% style %}
  #shopify-block-{{ block.id }} .slideshow-2__button-link {
    --buttons-border-width: 0px;
    border: 0;
    {% if block.settings.color != blank %}color: {{ block.settings.color }};{% endif %}
    {% if block.settings.style != 'link' and block.settings.background_color != blank %}
      background: {{ block.settings.background_color }};
      background-color: {{ block.settings.background_color }};
    {% endif %}
  }

  #shopify-block-{{ block.id }} .slideshow-2__button-link::after {
    border: 0;
  }

  {% if block.settings.style != 'link' and block.settings.hover_background_color != blank %}
    #shopify-block-{{ block.id }} .slideshow-2__button-link .btn-fill {
      background: {{ block.settings.hover_background_color }};
      background-color: {{ block.settings.hover_background_color }};
    }
  {% endif %}

  @media screen and (pointer: fine) {
    #shopify-block-{{ block.id }} .slideshow-2__button-link:hover {
      {% if block.settings.hover_color != blank %}color: {{ block.settings.hover_color }};{% endif %}
      {% if block.settings.style != 'link' and block.settings.hover_background_color != blank %}
        background: {{ block.settings.hover_background_color }};
        background-color: {{ block.settings.hover_background_color }};
      {% endif %}
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-block-{{ block.id }} .slideshow-2__button-link {
      {% if block.settings.color_mobile != blank %}
        color: {{ block.settings.color_mobile }};
      {% elsif block.settings.color != blank %}
        color: {{ block.settings.color }};
      {% endif %}
      {% if block.settings.style != 'link' and block.settings.background_color_mobile != blank %}
        background: {{ block.settings.background_color_mobile }};
        background-color: {{ block.settings.background_color_mobile }};
      {% elsif block.settings.style != 'link' and block.settings.background_color != blank %}
        background: {{ block.settings.background_color }};
        background-color: {{ block.settings.background_color }};
      {% endif %}
    }

    {% if block.settings.style != 'link' and block.settings.hover_background_color_mobile != blank %}
      #shopify-block-{{ block.id }} .slideshow-2__button-link .btn-fill {
        background: {{ block.settings.hover_background_color_mobile }};
        background-color: {{ block.settings.hover_background_color_mobile }};
      }
    {% elsif block.settings.style != 'link' and block.settings.hover_background_color != blank %}
      #shopify-block-{{ block.id }} .slideshow-2__button-link .btn-fill {
        background: {{ block.settings.hover_background_color }};
        background-color: {{ block.settings.hover_background_color }};
      }
    {% endif %}

  }

  @media screen and (max-width: 767px) and (pointer: fine) {
    #shopify-block-{{ block.id }} .slideshow-2__button-link:hover {
      {% if block.settings.hover_color_mobile != blank %}
        color: {{ block.settings.hover_color_mobile }};
      {% elsif block.settings.hover_color != blank %}
        color: {{ block.settings.hover_color }};
      {% endif %}
      {% if block.settings.style != 'link' and block.settings.hover_background_color_mobile != blank %}
        background: {{ block.settings.hover_background_color_mobile }};
        background-color: {{ block.settings.hover_background_color_mobile }};
      {% elsif block.settings.style != 'link' and block.settings.hover_background_color != blank %}
        background: {{ block.settings.hover_background_color }};
        background-color: {{ block.settings.hover_background_color }};
      {% endif %}
    }
  }
{% endstyle %}

{%- capture block_content -%}
  {%- if block.settings.label != blank -%}
    <div class="slideshow-2__button{% if block.settings.full_width_mobile %} slideshow-2__button--mobile-full{% endif %}">
      {% render 'button',
        label: block.settings.label,
        link: block.settings.link,
        size: block.settings.size,
        style: block.settings.style,
        external: block.settings.external,
        show_icon: block.settings.show_icon,
        classes: 'slideshow-2__button-link'
      %}
    </div>
  {%- endif -%}
{%- endcapture -%}

{% render 'slideshow-2-content-block', block: block, content: block_content %}

{% stylesheet %}
  @media screen and (max-width: 767px) {
    .slideshow-2__button--mobile-full,
    .slideshow-2__button--mobile-full .slideshow-2__button-link {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.slideshow_2.blocks.button.name",
  "settings": [
    { "type": "text", "id": "label", "label": "t:sections.slideshow_2.block_settings.button_label", "default": "Explore now" },
    { "type": "url", "id": "link", "label": "t:sections.slideshow_2.block_settings.button_link" },
    { "type": "select", "id": "style", "label": "t:sections.slideshow_2.block_settings.button_style", "options": [{ "value": "primary", "label": "t:general.primary" }, { "value": "secondary", "label": "t:general.secondary" }, { "value": "link", "label": "t:sections.slideshow_2.options.text_link" }], "default": "primary" },
    { "type": "select", "id": "size", "label": "t:sections.slideshow_2.block_settings.button_size", "options": [{ "value": "small", "label": "t:options.size.small" }, { "value": "md", "label": "t:sections.slideshow_2.options.medium" }, { "value": "large", "label": "t:options.size.large" }], "default": "md" },
    { "type": "checkbox", "id": "show_icon", "label": "t:sections.slideshow_2.block_settings.show_icon", "default": true },
    { "type": "checkbox", "id": "external", "label": "t:sections.slideshow_2.block_settings.open_new_window", "default": false },
    { "type": "checkbox", "id": "full_width_mobile", "label": "t:sections.slideshow_2.block_settings.full_width_mobile", "default": false },
    { "type": "color", "id": "color", "label": "t:sections.slideshow_2.block_settings.button_text_color" },
    { "type": "color", "id": "color_mobile", "label": "t:sections.slideshow_2.block_settings.button_text_color_mobile" },
    { "type": "color", "id": "background_color", "label": "t:sections.slideshow_2.block_settings.button_background_color", "visible_if": "{{ block.settings.style != 'link' }}" },
    { "type": "color", "id": "background_color_mobile", "label": "t:sections.slideshow_2.block_settings.button_background_color_mobile", "visible_if": "{{ block.settings.style != 'link' }}" },
    { "type": "header", "content": "t:sections.slideshow_2.block_settings.button_hover_header" },
    { "type": "color", "id": "hover_color", "label": "t:sections.slideshow_2.block_settings.button_hover_text_color" },
    { "type": "color", "id": "hover_color_mobile", "label": "t:sections.slideshow_2.block_settings.button_hover_text_color_mobile" },
    { "type": "color", "id": "hover_background_color", "label": "t:sections.slideshow_2.block_settings.button_hover_background_color", "visible_if": "{{ block.settings.style != 'link' }}" },
    { "type": "color", "id": "hover_background_color_mobile", "label": "t:sections.slideshow_2.block_settings.button_hover_background_color_mobile", "visible_if": "{{ block.settings.style != 'link' }}" },
    { "type": "header", "content": "t:sections.slideshow_2.block_settings.header_position" },
    { "type": "select", "id": "visibility", "label": "t:sections.slideshow_2.block_settings.visibility", "options": [{ "value": "all", "label": "t:sections.slideshow_2.options.all_devices" }, { "value": "desktop", "label": "t:sections.slideshow_2.options.desktop_only" }, { "value": "mobile", "label": "t:sections.slideshow_2.options.mobile_only" }], "default": "all" },
    { "type": "select", "id": "position_mode", "label": "t:sections.slideshow_2.block_settings.position_mode", "options": [{ "value": "flow", "label": "t:sections.slideshow_2.options.follow_stack" }, { "value": "free", "label": "t:sections.slideshow_2.options.free_position" }], "default": "flow" },
    { "type": "range", "id": "width", "min": 20, "max": 100, "step": 5, "unit": "%", "label": "t:sections.slideshow_2.block_settings.width", "default": 100 },
    { "type": "range", "id": "width_mobile", "min": 20, "max": 100, "step": 5, "unit": "%", "label": "t:sections.slideshow_2.block_settings.width_mobile", "default": 100 },
    { "type": "select", "id": "alignment", "label": "t:sections.slideshow_2.block_settings.alignment", "options": [{ "value": "flex-start", "label": "t:sections.slideshow_2.options.left" }, { "value": "center", "label": "t:sections.slideshow_2.options.center" }, { "value": "flex-end", "label": "t:sections.slideshow_2.options.right" }], "default": "flex-start" },
    { "type": "select", "id": "alignment_mobile", "label": "t:sections.slideshow_2.block_settings.alignment_mobile", "options": [{ "value": "flex-start", "label": "t:sections.slideshow_2.options.left" }, { "value": "center", "label": "t:sections.slideshow_2.options.center" }, { "value": "flex-end", "label": "t:sections.slideshow_2.options.right" }], "default": "flex-start" },
    { "type": "range", "id": "spacing_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "t:sections.slideshow_2.block_settings.spacing_top", "default": 24 },
    { "type": "range", "id": "spacing_top_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "t:sections.slideshow_2.block_settings.spacing_top_mobile", "default": 16 },
    { "type": "range", "id": "position_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "t:sections.slideshow_2.block_settings.position_x", "default": 50, "visible_if": "{{ block.settings.position_mode == 'free' }}" },
    { "type": "range", "id": "position_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "t:sections.slideshow_2.block_settings.position_y", "default": 50, "visible_if": "{{ block.settings.position_mode == 'free' }}" },
    { "type": "range", "id": "position_x_mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "t:sections.slideshow_2.block_settings.position_x_mobile", "default": 50, "visible_if": "{{ block.settings.position_mode == 'free' }}" },
    { "type": "range", "id": "position_y_mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "t:sections.slideshow_2.block_settings.position_y_mobile", "default": 50, "visible_if": "{{ block.settings.position_mode == 'free' }}" },
    { "type": "range", "id": "z_index", "min": 1, "max": 10, "step": 1, "label": "t:sections.slideshow_2.block_settings.z_index", "default": 2, "visible_if": "{{ block.settings.position_mode == 'free' }}" }
  ],
  "presets": [{ "name": "t:sections.slideshow_2.blocks.button.name" }]
}
{% endschema %}
