{% doc %}
  Renders a Concept-inspired information card inside the Product Share help drawer.
{% enddoc %}

{%- liquid
  assign has_highlight_gradient = false
  if block.settings.gradient_highlight != blank
    if block.settings.gradient_highlight != 'rgba(0,0,0,0)'
      assign has_highlight_gradient = true
    endif
  endif
-%}

<article
  class="help-list__item ekko-help-content grid gap-2 md:gap-3 relative z-1"
  data-product-help-entry
  style="{% render 'section-variables', section: block %}"
>
  <div class="ekko-help-content__heading flex items-center gap-3">
    {%- if block.settings.custom_icon != blank -%}
      {{ block.settings.custom_icon | image_url: width: 160 | image_tag:
        loading: 'lazy',
        widths: '40,64,96,128,160',
        sizes: '32px',
        class: 'ekko-help-content__custom-icon'
      }}
    {%- elsif block.settings.icon != 'none' -%}
      {%- render 'icon-guarantee', icon: block.settings.icon -%}
    {%- endif -%}

    {%- if block.settings.heading != blank -%}
      <p class="h4 font-medium leading-tight md:text-lg">
        {%- render 'highlighted-text',
          content: block.settings.heading,
          style: block.settings.highlighted_text,
          scribble: block.settings.highlighted_scribble,
          gradient: has_highlight_gradient
        -%}
      </p>
    {%- endif -%}
  </div>

  {%- if block.settings.text != blank -%}
    <div class="rte text-sm">{{ block.settings.text }}</div>
  {%- endif -%}
</article>

{% stylesheet %}
  .ekko-product-help-content-entry {
    display: block;
    min-width: 0;
  }

  .ekko-help-content {
    isolation: isolate;
    overflow: hidden;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .ekko-help-content:hover {
    transform: translateY(-2px);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / .08);
  }

  .ekko-help-content__heading:empty {
    display: none;
  }

  .ekko-help-content__custom-icon,
  .ekko-help-content__heading > .icon {
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
    object-fit: contain;
  }

  .ekko-help-content > .rte {
    margin-inline-start: 2.75rem;
  }

  .ekko-help-content .highlighted-text {
    z-index: 0;
  }

  @media screen and (max-width: 749px) {
    .ekko-help-content > .rte {
      margin-inline-start: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ekko-help-content {
      transition: none;
    }

    .ekko-help-content:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
