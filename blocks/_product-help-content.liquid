      "id": "icon",
      "label": "Icon",
      "default": "rocket",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "alert", "label": "Alert" },
        { "value": "award", "label": "Award" },
        { "value": "bag", "label": "Bag" },
        { "value": "box", "label": "Box" },
        { "value": "briefcase", "label": "Briefcase" },
        { "value": "calendar", "label": "Calendar" },
        { "value": "chat_bubble", "label": "Chat" },
        { "value": "check_mark", "label": "Check mark" },
        { "value": "clipboard", "label": "Clipboard" },
        { "value": "cosmetics", "label": "Cosmetics" },
        { "value": "creadit_card", "label": "Credit card" },
        { "value": "devices", "label": "Devices" },
        { "value": "email", "label": "Email" },
        { "value": "eye", "label": "Eye" },
        { "value": "file_text", "label": "File" },
        { "value": "gift", "label": "Gift" },
        { "value": "headphone", "label": "Headphones" },
        { "value": "heart", "label": "Heart" },
        { "value": "lightning", "label": "Lightning" },
        { "value": "lock", "label": "Lock" },
        { "value": "map_pin", "label": "Map pin" },
        { "value": "newspaper", "label": "Newspaper" },
        { "value": "organic", "label": "Organic" },
        { "value": "perfume", "label": "Perfume" },
        { "value": "phone", "label": "Phone" },
        { "value": "plane", "label": "Plane" },
        { "value": "planet", "label": "Planet" },
        { "value": "recycling", "label": "Recycling" },
        { "value": "return", "label": "Return" },
        { "value": "rocket", "label": "Rocket" },
        { "value": "ruler", "label": "Ruler" },
        { "value": "sale", "label": "Sale" },
        { "value": "shield", "label": "Shield" },
        { "value": "shirt", "label": "Shirt" },
        { "value": "shoe", "label": "Shoe" },
        { "value": "star", "label": "Star" },
        { "value": "support", "label": "Support" },
        { "value": "swatchbook", "label": "Swatchbook" },
        { "value": "tag", "label": "Tag" },
        { "value": "time", "label": "Time" },
        { "value": "trophy", "label": "Trophy" },
        { "value": "truck", "label": "Truck" },
        { "value": "users", "label": "Users" },
        { "value": "wallet", "label": "Wallet" },
        { "value": "wash", "label": "Wash" },
        { "value": "watch", "label": "Watch" },
        { "value": "wrench", "label": "Wrench" }
      ]
    },
    { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Overrides the selected icon." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shipping <em>information</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use this content to answer customer questions in detail.</p>" },
    { "type": "header", "content": "Heading highlight", "info": "Italicized words in the heading receive the selected highlight style." },
    {
      "type": "select",
      "id": "highlighted_text",
      "label": "Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "text", "label": "Colored text" },
        { "value": "full_text", "label": "Full highlight" },
        { "value": "half_text", "label": "Half highlight" },
        { "value": "underline", "label": "Underline" },
        { "value": "stencil", "label": "Stencil" },
        { "value": "scribble", "label": "Scribble" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "highlighted_scribble",
      "label": "Scribble style",
      "visible_if": "{{ block.settings.highlighted_text == 'scribble' }}",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "basic-underline", "label": "Basic underline" },
        { "value": "sketch-underline", "label": "Sketch underline" },
        { "value": "squiggle-underline", "label": "Squiggle underline" },
        { "value": "squiggle-underline-2", "label": "Double squiggle" }
      ],
      "default": "circle"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#7C4A03" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#FFF8E8" },
    { "type": "color_background", "id": "gradient_background", "label": "Background gradient" },
    { "type": "color", "id": "color_highlight", "label": "Highlight", "default": "#FFD99A" },
    { "type": "color_background", "id": "gradient_highlight", "label": "Highlight gradient" }
  ],
  "presets": [
    {
      "name": "Help drawer content",
      "settings": {
        "icon": "rocket",
        "heading": "Shipping <em>information</em>",
        "highlighted_text": "half_text"
      }
    }
  ]
}
{% endschema %}
