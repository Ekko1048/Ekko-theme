{% doc %}
  Renders one item in the Product details Included in the box sidebar.
{% enddoc %}

{%- if block.settings.image != blank or block.settings.heading != blank -%}
  <div class="ekko-product-details__included-item" {{ block.shopify_attributes }}>
    <div class="ekko-product-details__included-media">
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '120,180,240,360,480', sizes: '176px', class: 'ekko-product-details__included-image' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'ekko-product-details__included-placeholder' }}
      {%- endif -%}
    </div>
    {%- if block.settings.heading != blank -%}
      <p class="ekko-product-details__included-title">
        {{- block.settings.heading | escape -}}
        {%- if block.settings.quantity > 1 %} ×{{ block.settings.quantity }}{% endif -%}
      </p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .ekko-product-details__included-item {
    display: grid;
    gap: .65rem;
    justify-items: center;
  }

  .ekko-product-details__included-media {
    display: grid;
    width: min(100%, var(--ekko-pd-included-item-size, 7rem));
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: var(--ekko-product-details-background);
  }

  .ekko-product-details__included-image {
    width: var(--ekko-pd-included-image-scale, 75%);
    height: var(--ekko-pd-included-image-scale, 75%);
    object-fit: contain;
  }

  .ekko-product-details__included-placeholder {
    width: var(--ekko-pd-included-image-scale, 75%);
    height: var(--ekko-pd-included-image-scale, 75%);
  }

  .ekko-product-details__included-title {
    margin: 0;
    font-size: .875rem;
    line-height: 1.3;
    text-wrap: balance;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Included item",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Included item" },
    { "type": "number", "id": "quantity", "label": "Quantity", "default": 1, "info": "Enter any quantity. The quantity is shown when it is greater than 1." }
  ],
  "presets": [{ "name": "Included item" }]
}
{% endschema %}
