{%- liquid
  assign frame_class = 'page-width'
  if section.settings.content_width == 'full' or section.settings.content_width == 'custom'
    assign frame_class = 'page-width page-width--full'
  endif
  case section.settings.gap
    when 'small'
      assign counter_gap = 16
    when 'medium'
      assign counter_gap = 24
    else
      assign counter_gap = 40
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ekko-counter-width: {{ section.settings.custom_content_width }}vw;
    --ekko-counter-columns: {{ section.settings.columns }};
    --ekko-counter-columns-mobile: {{ section.settings.columns_mobile }};
    --ekko-counter-gap: {{ counter_gap }}px;
    --ekko-counter-gap-mobile: {{ section.settings.gap_mobile }}px;
    --ekko-counter-number-size: {{ section.settings.number_size }}px;
    --ekko-counter-number-size-mobile: {{ section.settings.number_size_mobile }}px;
    --ekko-counter-card-radius: {{ section.settings.card_radius }}px;
    --ekko-counter-heading-size: {{ section.settings.heading_size }}px;
    --ekko-counter-card-background: {{ section.settings.card_background }};
    --ekko-counter-card-text: {{ section.settings.card_text }};
    {%- if section.settings.gradient_highlight != blank and section.settings.gradient_highlight != 'rgba(0,0,0,0)' -%}
      --ekko-counter-number-fill: {{ section.settings.gradient_highlight }};
    {%- else -%}
      --ekko-counter-number-fill: {{ section.settings.color_highlight }};
    {%- endif -%}
    {%- render 'section-variables', section: section -%}
  }
{% endstyle %}

<div class="section section--padding ekko-counter-section{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded{% endif %}">
  <div class="ekko-counter__frame ekko-paint-layer {{ frame_class }}" data-width="{{ section.settings.content_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="ekko-counter__header" data-align="{{ section.settings.heading_alignment }}">
        <{{ section.settings.heading_tag }} class="ekko-counter__heading">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        {%- if section.settings.description != blank -%}<div class="rte">{{ section.settings.description }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="ekko-counter-grid" data-style="{{ section.settings.card_style | default: 'minimal' }}" data-columns="{{ section.settings.columns }}" data-columns-mobile="{{ section.settings.columns_mobile }}" data-swipe="{{ section.settings.swipe_on_mobile }}" role="list">
      {%- for block in section.blocks -%}
        <article class="ekko-counter-card" data-align="{{ section.settings.text_alignment }}" data-align-mobile="{{ section.settings.text_alignment_mobile }}" role="listitem" {{ block.shopify_attributes }}>
          {%- if block.settings.number != blank -%}
            <p class="ekko-counter-card__number">
              {%- if block.settings.prefix != blank -%}<span>{{ block.settings.prefix | escape }}</span>{%- endif -%}
              <ekko-number-counter data-value="{{ block.settings.number | escape }}" data-duration="{{ block.settings.duration }}">{{ block.settings.number | escape }}</ekko-number-counter>
              {%- if block.settings.unit != blank -%}<span>{{ block.settings.unit | escape }}</span>{%- endif -%}
            </p>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<div class="ekko-counter-card__title rte">{{ block.settings.title | newline_to_br }}</div>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ekko-counter-section { color: rgb(var(--color-foreground)); background: var(--gradient-background, rgb(var(--color-background))); }
  .ekko-counter__frame { min-width: 0; }
  .ekko-counter__header { display: grid; gap: 1rem; max-width: 52rem; margin-block-end: clamp(2rem, 4vw, 3.5rem); }
  .ekko-counter__header[data-align='center'] { margin-inline: auto; text-align: center; }
  .ekko-counter__header[data-align='right'] { margin-inline-start: auto; text-align: end; }
  .ekko-counter__heading { margin: 0; font-family: var(--font-heading-family); font-size: clamp(2rem, 5vw, var(--ekko-counter-heading-size)); line-height: 1.05; letter-spacing: -.035em; }
  .ekko-counter-grid { display: grid; grid-template-columns: repeat(var(--ekko-counter-columns), minmax(0, 1fr)); align-items: start; gap: var(--ekko-counter-gap); min-width: 0; }
  .ekko-counter-card { position: relative; display: grid; align-content: start; gap: clamp(.75rem, 1.5vw, 1.25rem); min-width: 0; padding: 0; color: var(--ekko-counter-card-text); }
  .ekko-counter-grid[data-style='cards'] .ekko-counter-card { min-height: clamp(10rem, 15vw, 13rem); padding: clamp(1.5rem, 2.5vw, 2.25rem); border-radius: var(--ekko-counter-card-radius); background: var(--ekko-counter-card-background); overflow: hidden; transition: transform 300ms cubic-bezier(.22, 1, .36, 1), box-shadow 300ms ease; }
  @media (hover: hover) {
    .ekko-counter-grid[data-style='cards'] .ekko-counter-card:hover { transform: translateY(-4px); box-shadow: 0 1.25rem 3rem rgb(0 0 0 / .08); }
  }
  .ekko-counter-card[data-align='left'] { text-align: start; justify-items: start; }
  .ekko-counter-card[data-align='center'] { text-align: center; justify-items: center; }
  .ekko-counter-card[data-align='right'] { text-align: end; justify-items: end; }
  .ekko-counter-card__number { display: flex; align-items: baseline; gap: .04em; min-width: 0; max-width: 100%; margin: 0; color: rgb(var(--color-highlight)); font-family: var(--font-heading-family); font-size: clamp(3rem, 6vw, var(--ekko-counter-number-size)); font-weight: 700; line-height: .9; letter-spacing: -.05em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ekko-counter-card__number ekko-number-counter { display: inline-block; min-width: .65em; }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .ekko-counter-card__number > * { background: var(--ekko-counter-number-fill); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  }
  .ekko-counter-card__title { max-width: 22ch; font-family: var(--font-heading-family); font-size: clamp(1.0625rem, 1.5vw, 1.5rem); font-weight: 500; line-height: 1.2; letter-spacing: -.02em; text-wrap: balance; }
  .ekko-counter-card[data-counting] { animation: ekko-counter-enter 700ms cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes ekko-counter-enter {
    from { opacity: .45; transform: translateY(.75rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media screen and (min-width: 750px) {
    .ekko-counter__frame[data-width='custom'] { width: min(100%, var(--ekko-counter-width)); max-width: var(--ekko-counter-width); margin-inline: auto; }
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ekko-counter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 749px) {
    .ekko-counter-grid { grid-template-columns: repeat(var(--ekko-counter-columns-mobile), minmax(0, 1fr)); gap: var(--ekko-counter-gap-mobile); }
    .ekko-counter__header { margin-block-end: 2rem; }
    .ekko-counter-grid[data-style='cards'] .ekko-counter-card { min-height: 10rem; padding: 1.25rem; }
    .ekko-counter-grid[data-swipe='true'] { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(78vw, 18.5rem); gap: .75rem; margin-inline-end: calc(var(--page-padding, 1.25rem) * -1); padding-inline-end: var(--page-padding, 1.25rem); overflow-x: auto; scroll-padding-inline: 0; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .ekko-counter-grid[data-style='minimal'][data-swipe='true'] .ekko-counter-card { min-height: 10rem; padding: 1.35rem; border-radius: var(--ekko-counter-card-radius); background: var(--ekko-counter-card-background); }
    .ekko-counter-grid[data-swipe='true']::-webkit-scrollbar { display: none; }
    .ekko-counter-grid[data-swipe='true'] .ekko-counter-card { scroll-snap-align: start; scroll-snap-stop: always; }
    .ekko-counter-card[data-align-mobile='left'] { text-align: start; justify-items: start; }
    .ekko-counter-card[data-align-mobile='center'] { text-align: center; justify-items: center; }
    .ekko-counter-card[data-align-mobile='right'] { text-align: end; justify-items: end; }
    .ekko-counter-card__number { font-size: clamp(2.5rem, 12vw, var(--ekko-counter-number-size-mobile)); }
    .ekko-counter-card__title { font-size: clamp(1rem, 4.5vw, 1.1875rem); line-height: 1.18; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ekko-counter-card[data-counting] { animation: none; }
  }
{% endstylesheet %}

<script src="{{ 'ekko-number-counter.js' | asset_url }}" defer="defer"></script>
{% comment %}
<script>
  if (!customElements.get('ekko-number-counter')) {
    customElements.define('ekko-number-counter', class extends HTMLElement {
      connectedCallback() {
        this.finalText = this.dataset.value.trim();
        const normalized = this.finalText.replace(/\s/g, '').replace(/,(?=\d{3}(?:\D|$))/g, '');
        this.value = Number.parseFloat(normalized.replace(',', '.'));
        if (!Number.isFinite(this.value)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || (window.Shopify && Shopify.designMode)) {
          this.textContent = this.finalText;
          return;
        }
        this.observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          this.observer.disconnect();
          this.animate();
        }, { rootMargin: '0px 0px -10% 0px', threshold: .25 });
        this.observer.observe(this);
      }
      disconnectedCallback() { this.observer?.disconnect(); cancelAnimationFrame(this.frame); }
      animate() {
        const duration = Math.max(.1, Number.parseFloat(this.dataset.duration) || 2) * 1000;
        const decimals = (this.finalText.match(/[.,](\d+)$/)?.[1] || '').length;
        const formatter = new Intl.NumberFormat(document.documentElement.lang || 'en', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
        const start = performance.now();
        const tick = (now) => {
          const progress = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - progress, 4);
          this.textContent = progress === 1 ? this.finalText : formatter.format(this.value * eased);
          if (progress < 1) this.frame = requestAnimationFrame(tick);
        };
        this.frame = requestAnimationFrame(tick);
      }
    });
  }
</script>
{% endcomment %}

{% schema %}
{
  "name": "t:sections.number-counter.name",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "gap", "label": "t:sections.multicolumn.settings.gap.label", "options": [{ "value": "small", "label": "t:sections.multicolumn.settings.gap.options__1.label" }, { "value": "medium", "label": "t:sections.multicolumn.settings.gap.options__2.label" }, { "value": "large", "label": "t:sections.multicolumn.settings.gap.options__3.label" }], "default": "medium" },
    { "type": "range", "id": "columns", "label": "t:sections.global.settings.columns.label", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "text_alignment", "id": "text_alignment", "label": "t:sections.global.settings.text_alignment.label", "default": "center" },
    { "type": "range", "id": "number_size", "label": "Number size", "min": 40, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "select", "id": "card_style", "label": "Counter style", "options": [{ "value": "minimal", "label": "Clean" }, { "value": "cards", "label": "Soft cards" }], "default": "minimal" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f5f5f5" },
    { "type": "color", "id": "card_text", "label": "Card text", "default": "#171717" },
    { "type": "select", "id": "content_width", "label": "Content width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }, { "value": "custom", "label": "Custom" }], "default": "page" },
    { "type": "range", "id": "custom_content_width", "label": "Custom content width", "min": 60, "max": 100, "step": 1, "unit": "%", "default": 90, "visible_if": "{{ section.settings.content_width == 'custom' }}" },
    { "type": "header", "content": "Mobile" },
    { "type": "select", "id": "columns_mobile", "label": "t:sections.global.settings.columns_mobile.label", "options": [{ "value": "1", "label": "t:sections.global.settings.columns_mobile.options__1.label" }, { "value": "2", "label": "t:sections.global.settings.columns_mobile.options__2.label" }], "default": "1" },
    { "type": "checkbox", "id": "swipe_on_mobile", "label": "t:sections.global.settings.swipe_on_mobile.label", "default": true },
    { "type": "text_alignment", "id": "text_alignment_mobile", "label": "t:sections.global.settings.text_alignment_mobile.label", "default": "center" },
    { "type": "range", "id": "gap_mobile", "label": "Mobile gap", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "number_size_mobile", "label": "Mobile number size", "min": 32, "max": 80, "step": 4, "unit": "px", "default": 52 },
    { "type": "header", "content": "Optional heading" },
    { "type": "inline_richtext", "id": "heading", "label": "t:sections.global.settings.heading.label" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 32, "max": 80, "step": 4, "unit": "px", "default": 56 },
    { "type": "select", "id": "heading_tag", "label": "t:sections.global.settings.heading_tag.label", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }, { "value": "div", "label": "Div" }], "default": "h2" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "richtext", "id": "description", "label": "t:sections.global.settings.description.label" },
    { "type": "header", "content": "t:sections.global.settings.header__colors.content" },
    { "type": "color", "id": "color_text", "label": "t:sections.global.settings.color_text.label", "default": "#171717" },
    { "type": "color", "id": "color_background", "label": "t:sections.global.settings.color_background.label", "default": "#ffffff" },
    { "type": "color_background", "id": "gradient_background", "label": "t:sections.global.settings.gradient_background.label" },
    { "type": "color", "id": "color_highlight", "label": "t:sections.global.settings.color_highlight.label", "default": "#171717" },
    { "type": "color_background", "id": "gradient_highlight", "label": "t:sections.global.settings.gradient_highlight.label" },
    { "type": "header", "content": "t:sections.global.settings.header__section.content" },
    { "type": "range", "id": "padding_top", "label": "t:sections.global.settings.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.global.settings.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "checkbox", "id": "divider", "label": "t:sections.global.settings.divider.label", "default": false },
    { "type": "checkbox", "id": "rounded", "label": "t:sections.global.settings.rounded.label", "default": false }
  ],
  "blocks": [
    { "type": "counter", "name": "t:sections.number-counter.blocks.counter.name", "settings": [
      { "type": "textarea", "id": "title", "label": "t:sections.global.settings.title.label", "default": "Happy customers" },
      { "type": "text", "id": "prefix", "label": "Prefix" },
      { "type": "text", "id": "number", "label": "t:sections.number-counter.blocks.counter.settings.number.label", "default": "100" },
      { "type": "text", "id": "unit", "label": "t:sections.number-counter.blocks.counter.settings.unit.label", "default": "+" },
      { "type": "range", "id": "duration", "label": "t:sections.number-counter.blocks.counter.settings.duration.label", "min": 0.5, "max": 5, "step": 0.1, "unit": "s", "default": 2 }
    ] }
  ],
  "presets": [{ "name": "t:sections.number-counter.presets.name", "blocks": [{ "type": "counter" }, { "type": "counter" }, { "type": "counter" }, { "type": "counter" }] }],
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] }
}
{% endschema %}
