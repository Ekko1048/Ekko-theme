{%- liquid
  assign frame_class = 'page-width'
  if section.settings.content_width == 'full' or section.settings.content_width == 'custom'
    assign frame_class = 'page-width page-width--full'
  endif
  assign with_gradient = false
  if section.settings.gradient_highlight != blank
    assign with_gradient = true
  endif
  case section.settings.gap
    when 'small'
      assign desktop_gap = 16
    when 'medium'
      assign desktop_gap = 24
    else
      assign desktop_gap = 40
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ekko-multicolumn-width: {{ section.settings.custom_content_width }}vw;
    --ekko-multicolumn-columns: {{ section.settings.columns }};
    --ekko-multicolumn-columns-mobile: {{ section.settings.columns_mobile }};
    --ekko-multicolumn-gap: {{ desktop_gap }}px;
    --ekko-multicolumn-gap-mobile: {{ section.settings.gap_mobile }}px;
    --ekko-multicolumn-radius: {{ section.settings.card_radius }}px;
    --ekko-multicolumn-card-background: {{ section.settings.card_background }};
    --ekko-multicolumn-card-text: {{ section.settings.card_text }};
    {%- render 'section-variables', section: section -%}
  }
{% endstyle %}

<div class="section section--padding ekko-multicolumn-section{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded{% endif %}">
  <div class="ekko-multicolumn__frame {{ frame_class }}" data-width="{{ section.settings.content_width }}">
    {%- render 'section-heading', section: section -%}

    <div class="ekko-multicolumn ekko-paint-layer" data-swipe="{{ section.settings.swipe_on_mobile }}" data-card-layout="{{ section.settings.card_layout }}" role="list">
      {%- for block in section.blocks -%}
        <article
          class="ekko-multicolumn-card{% if block.settings.show_border %} ekko-multicolumn-card--border{% endif %}"
          data-align="{{ block.settings.text_alignment }}"
          data-align-mobile="{{ block.settings.text_alignment_mobile }}"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          {%- capture media -%}
            {%- if block.settings.video != blank -%}
              <div class="ekko-multicolumn-card__media ekko-multicolumn-card__media--{{ block.settings.image_ratio }}">
                {{ block.settings.video | video_tag: image_size: '1200x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
              </div>
            {%- elsif block.settings.image != blank -%}
              <div class="ekko-multicolumn-card__media ekko-multicolumn-card__media--{{ block.settings.image_ratio }}"{% if block.settings.image_ratio == 'adapt' %} style="--ekko-media-ratio: {{ block.settings.image.aspect_ratio }}"{% endif %}>
                {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '240, 360, 480, 720, 960, 1200, 1500, 1800', sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw', class: 'ekko-multicolumn-card__image' }}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if media != blank -%}
            {%- if block.settings.button_link != blank -%}
              <a class="ekko-multicolumn-card__media-link" href="{{ block.settings.button_link }}"{% if block.settings.button_external %} target="_blank" rel="noopener"{% endif %} aria-label="{{ block.settings.heading | strip_html | escape }}">{{ media }}</a>
            {%- else -%}
              {{ media }}
            {%- endif -%}
          {%- endif -%}

          {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
            <div class="ekko-multicolumn-card__content">
              {%- if block.settings.heading != blank -%}
                <h3 class="ekko-multicolumn-card__heading" style="--ekko-card-heading-size: {{ block.settings.heading_size }}px">
                  {%- render 'highlighted-text', content: block.settings.heading, style: block.settings.highlighted_text, scribble: block.settings.highlighted_scribble, gradient: with_gradient -%}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}<div class="ekko-multicolumn-card__text rte">{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="ekko-multicolumn-card__action">
                  {%- render 'button', label: block.settings.button_label, link: block.settings.button_link, style: block.settings.button_style, external: block.settings.button_external, show_icon: block.settings.button_icon -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ekko-multicolumn-section { color: rgb(var(--color-foreground)); background: var(--gradient-background, rgb(var(--color-background))); }
  .ekko-multicolumn__frame { min-width: 0; }
  .ekko-multicolumn { display: grid; grid-template-columns: repeat(var(--ekko-multicolumn-columns), minmax(0, 1fr)); gap: var(--ekko-multicolumn-gap); min-width: 0; }
  .ekko-multicolumn-card { display: flex; min-width: 0; height: 100%; flex-direction: column; gap: 0; padding: 0; border-radius: var(--ekko-multicolumn-radius); color: var(--ekko-multicolumn-card-text); background: var(--ekko-multicolumn-card-background); overflow: hidden; }
  .ekko-multicolumn-card--border { box-shadow: inset 0 0 0 1px rgb(var(--color-foreground) / .14); }
  .ekko-multicolumn-card__media-link { display: block; color: inherit; }
  .ekko-multicolumn-card__media { position: relative; width: 100%; overflow: hidden; background: rgb(var(--color-foreground) / .05); }
  .ekko-multicolumn-card__media--square { aspect-ratio: 1; }
  .ekko-multicolumn-card__media--portrait { aspect-ratio: 4 / 5; }
  .ekko-multicolumn-card__media--landscape { aspect-ratio: 4 / 3; }
  .ekko-multicolumn-card__media--adapt { aspect-ratio: var(--ekko-media-ratio, 4 / 3); }
  .ekko-multicolumn-card__media :is(img, video) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(.22, 1, .36, 1); }
  @media (hover: hover) { .ekko-multicolumn-card__media-link:hover :is(img, video) { transform: scale(1.025); } }
  .ekko-multicolumn-card__content { display: grid; align-content: start; gap: 1rem; height: 100%; padding: clamp(1.5rem, 2.5vw, 2.25rem) clamp(1.25rem, 2vw, 2rem); }
  .ekko-multicolumn-card[data-align='left'] .ekko-multicolumn-card__content { text-align: start; justify-items: start; }
  .ekko-multicolumn-card[data-align='center'] .ekko-multicolumn-card__content { text-align: center; justify-items: center; }
  .ekko-multicolumn-card[data-align='right'] .ekko-multicolumn-card__content { text-align: end; justify-items: end; }
  .ekko-multicolumn-card__heading { margin: 0; font-family: var(--font-heading-family); font-size: clamp(1.25rem, 2vw, var(--ekko-card-heading-size)); font-weight: var(--font-heading-weight); line-height: 1.12; letter-spacing: -.025em; }
  .ekko-multicolumn-card__text { line-height: 1.6; opacity: .78; }
  .ekko-multicolumn-card__action { align-self: end; margin-block-start: auto; padding-block-start: .25rem; }
  @media screen and (min-width: 750px) {
    .ekko-multicolumn__frame[data-width='custom'] { width: min(100%, var(--ekko-multicolumn-width)); max-width: var(--ekko-multicolumn-width); margin-inline: auto; }
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ekko-multicolumn { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (min-width: 990px) {
    .ekko-multicolumn[data-card-layout='horizontal'] .ekko-multicolumn-card:has(.ekko-multicolumn-card__media) { display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 1fr); }
    .ekko-multicolumn[data-card-layout='horizontal'] .ekko-multicolumn-card__media-link,
    .ekko-multicolumn[data-card-layout='horizontal'] .ekko-multicolumn-card__media { height: 100%; }
    .ekko-multicolumn[data-card-layout='horizontal'] .ekko-multicolumn-card__media { aspect-ratio: auto; min-height: 15rem; }
  }
  @media screen and (max-width: 749px) {
    .ekko-multicolumn { grid-template-columns: repeat(var(--ekko-multicolumn-columns-mobile), minmax(0, 1fr)); gap: var(--ekko-multicolumn-gap-mobile); }
    .ekko-multicolumn[data-swipe='true'] { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - var(--ekko-multicolumn-gap-mobile) * (var(--ekko-multicolumn-columns-mobile) - 1)) / var(--ekko-multicolumn-columns-mobile)); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; scrollbar-width: none; }
    .ekko-multicolumn[data-swipe='true']::-webkit-scrollbar { display: none; }
    .ekko-multicolumn[data-swipe='true'] .ekko-multicolumn-card { scroll-snap-align: start; scroll-snap-stop: always; }
    .ekko-multicolumn-card[data-align-mobile='left'] .ekko-multicolumn-card__content { text-align: start; justify-items: start; }
    .ekko-multicolumn-card[data-align-mobile='center'] .ekko-multicolumn-card__content { text-align: center; justify-items: center; }
    .ekko-multicolumn-card[data-align-mobile='right'] .ekko-multicolumn-card__content { text-align: end; justify-items: end; }
    .ekko-multicolumn-card__content { padding-inline: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { .ekko-multicolumn-card__media :is(img, video) { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "gap", "label": "t:sections.multicolumn.settings.gap.label", "options": [{ "value": "small", "label": "t:sections.multicolumn.settings.gap.options__1.label" }, { "value": "medium", "label": "t:sections.multicolumn.settings.gap.options__2.label" }, { "value": "large", "label": "t:sections.multicolumn.settings.gap.options__3.label" }], "default": "large" },
    { "type": "range", "id": "columns", "label": "t:sections.global.settings.columns.label", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "card_layout", "label": "Desktop card layout", "options": [{ "value": "vertical", "label": "Vertical" }, { "value": "horizontal", "label": "Media beside content" }], "default": "vertical" },
    { "type": "select", "id": "content_width", "label": "Content width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }, { "value": "custom", "label": "Custom" }], "default": "page" },
    { "type": "range", "id": "custom_content_width", "label": "Custom content width", "min": 60, "max": 100, "step": 1, "unit": "%", "default": 90, "visible_if": "{{ section.settings.content_width == 'custom' }}" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f5f5f5" },
    { "type": "color", "id": "card_text", "label": "Card text", "default": "#171717" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "t:sections.global.settings.header__mobile.content" },
    { "type": "select", "id": "columns_mobile", "label": "t:sections.global.settings.columns_mobile.label", "options": [{ "value": "1", "label": "t:sections.global.settings.columns_mobile.options__1.label" }, { "value": "2", "label": "t:sections.global.settings.columns_mobile.options__2.label" }], "default": "1" },
    { "type": "range", "id": "gap_mobile", "label": "Mobile gap", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "swipe_on_mobile", "label": "t:sections.global.settings.swipe_on_mobile.label", "default": true },
    { "type": "header", "content": "t:sections.global.settings.header__heading.content" },
    { "type": "inline_richtext", "id": "heading", "label": "t:sections.global.settings.heading.label", "default": "Multicolumn" },
    { "type": "select", "id": "heading_size", "label": "t:sections.global.settings.heading_size.label", "options": [{ "value": "title-sm", "label": "t:sections.global.settings.heading_size.options__1.label" }, { "value": "title-md", "label": "t:sections.global.settings.heading_size.options__2.label" }, { "value": "title-lg tracking-heading", "label": "t:sections.global.settings.heading_size.options__3.label" }, { "value": "title-xl tracking-heading", "label": "t:sections.global.settings.heading_size.options__4.label" }], "default": "title-md" },
    { "type": "select", "id": "heading_alignment", "label": "t:sections.global.settings.heading_alignment.label", "options": [{ "value": "text-left md:items-end md:flex-row", "label": "t:sections.global.settings.heading_alignment.options__1.label" }, { "value": "text-center md:items-center", "label": "t:sections.global.settings.heading_alignment.options__2.label" }, { "value": "text-right md:items-end md:flex-row-reverse", "label": "t:sections.global.settings.heading_alignment.options__3.label" }], "default": "text-center md:items-center" },
    { "type": "select", "id": "heading_tag", "label": "t:sections.global.settings.heading_tag.label", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }, { "value": "div", "label": "Div" }], "default": "h2" },
    { "type": "text", "id": "subheading", "label": "t:sections.global.settings.subheading.label" },
    { "type": "richtext", "id": "description", "label": "t:sections.global.settings.description.label" },
    { "type": "text", "id": "button_label", "label": "t:sections.global.settings.button_label.label" },
    { "type": "url", "id": "button_link", "label": "t:sections.global.settings.button_link.label" },
    { "type": "checkbox", "id": "button_external", "label": "t:sections.global.settings.button_external.label", "default": false, "visible_if": "{{ section.settings.button_label != blank }}" },
    { "type": "checkbox", "id": "button_icon", "label": "t:sections.global.settings.button_icon.label", "default": true, "visible_if": "{{ section.settings.button_label != blank }}" },
    { "type": "header", "content": "t:sections.global.settings.header__highlight.content" },
    { "type": "select", "id": "highlighted_text", "label": "t:sections.global.settings.highlighted_text.label", "options": [{ "value": "none", "label": "None" }, { "value": "text", "label": "Text" }, { "value": "full_text", "label": "Full text" }, { "value": "half_text", "label": "Half text" }, { "value": "underline", "label": "Underline" }, { "value": "stencil", "label": "Stencil" }, { "value": "scribble", "label": "Scribble" }], "default": "none" },
    { "type": "select", "id": "highlighted_scribble", "label": "Scribble style", "options": [{ "value": "circle", "label": "Circle" }, { "value": "basic-underline", "label": "Basic underline" }, { "value": "sketch-underline", "label": "Sketch underline" }, { "value": "squiggle-underline", "label": "Squiggle underline" }, { "value": "squiggle-underline-2", "label": "Squiggle underline 2" }], "default": "circle", "visible_if": "{{ section.settings.highlighted_text == 'scribble' }}" },
    { "type": "header", "content": "t:sections.global.settings.header__colors.content" },
    { "type": "color", "id": "color_text", "label": "t:sections.global.settings.color_text.label", "default": "#171717" },
    { "type": "color", "id": "color_background", "label": "t:sections.global.settings.color_background.label", "default": "#ffffff" },
    { "type": "color_background", "id": "gradient_background", "label": "t:sections.global.settings.gradient_background.label" },
    { "type": "color", "id": "color_highlight", "label": "t:sections.global.settings.color_highlight.label", "default": "#d7ff64" },
    { "type": "color_background", "id": "gradient_highlight", "label": "t:sections.global.settings.gradient_highlight.label" },
    { "type": "color", "id": "color_button_text", "label": "t:sections.global.settings.color_button_text.label" },
    { "type": "color", "id": "color_button_background", "label": "t:sections.global.settings.color_button_background.label" },
    { "type": "color_background", "id": "color_button_gradient", "label": "t:sections.global.settings.color_button_gradient.label" },
    { "type": "header", "content": "t:sections.global.settings.header__section.content" },
    { "type": "range", "id": "padding_top", "label": "t:sections.global.settings.padding_top.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.global.settings.padding_bottom.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "checkbox", "id": "divider", "label": "t:sections.global.settings.divider.label", "default": false },
    { "type": "checkbox", "id": "rounded", "label": "t:sections.global.settings.rounded.label", "default": false }
  ],
  "blocks": [
    { "type": "column", "name": "t:sections.multicolumn.blocks.column.name", "settings": [
      { "type": "checkbox", "id": "show_border", "label": "t:sections.multicolumn.blocks.column.settings.show_border.label", "default": false },
      { "type": "text_alignment", "id": "text_alignment", "label": "t:sections.global.settings.text_alignment.label", "default": "left" },
      { "type": "text_alignment", "id": "text_alignment_mobile", "label": "t:sections.global.settings.text_alignment_mobile.label", "default": "left" },
      { "type": "image_picker", "id": "image", "label": "t:sections.global.settings.image.label" },
      { "type": "video", "id": "video", "label": "Video" },
      { "type": "select", "id": "image_ratio", "label": "t:sections.global.settings.image_ratio.label", "options": [{ "value": "adapt", "label": "Adapt to media" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }], "default": "landscape" },
      { "type": "inline_richtext", "id": "heading", "label": "t:sections.global.settings.heading.label", "default": "Column" },
      { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 28 },
      { "type": "richtext", "id": "text", "label": "t:sections.global.settings.text.label", "default": "<p>Pair text with an image to focus on a product, collection or story.</p>" },
      { "type": "text", "id": "button_label", "label": "t:sections.global.settings.button_label.label" },
      { "type": "url", "id": "button_link", "label": "t:sections.global.settings.button_link.label" },
      { "type": "select", "id": "button_style", "label": "t:sections.global.settings.button_style.label", "options": [{ "value": "primary", "label": "t:sections.global.settings.button_style.options__1.label" }, { "value": "secondary", "label": "t:sections.global.settings.button_style.options__2.label" }, { "value": "link", "label": "t:sections.global.settings.button_style.options__3.label" }], "default": "link" },
      { "type": "checkbox", "id": "button_external", "label": "t:sections.global.settings.button_external.label", "default": false },
      { "type": "checkbox", "id": "button_icon", "label": "t:sections.global.settings.button_icon.label", "default": true },
      { "type": "select", "id": "highlighted_text", "label": "t:sections.global.settings.highlighted_text.label", "options": [{ "value": "none", "label": "None" }, { "value": "text", "label": "Text" }, { "value": "full_text", "label": "Full text" }, { "value": "half_text", "label": "Half text" }, { "value": "underline", "label": "Underline" }, { "value": "stencil", "label": "Stencil" }, { "value": "scribble", "label": "Scribble" }], "default": "none" },
      { "type": "select", "id": "highlighted_scribble", "label": "Scribble style", "options": [{ "value": "circle", "label": "Circle" }, { "value": "basic-underline", "label": "Basic underline" }, { "value": "sketch-underline", "label": "Sketch underline" }, { "value": "squiggle-underline", "label": "Squiggle underline" }, { "value": "squiggle-underline-2", "label": "Squiggle underline 2" }], "default": "circle", "visible_if": "{{ block.settings.highlighted_text == 'scribble' }}" }
    ] }
  ],
  "presets": [{ "name": "t:sections.multicolumn.presets.name", "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }] }],
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] }
}
{% endschema %}
